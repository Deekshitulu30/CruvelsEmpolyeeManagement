# ─── Cruvels Frontend Client Environment Configuration ──────────────────────

# Backend REST API endpoint (proxied to http://localhost:5000 in Vite dev mode)
VITE_API_URL=/api

# Google Identity Services / OAuth 2.0 Client ID (optional, leave blank for native Account Chooser)
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra ID / Azure AD Application Client ID (optional, leave blank for native Account Chooser)
VITE_MICROSOFT_CLIENT_ID=

# Environment
.env
.env.*
!.env.example

# Dependencies
node_modules/
frontend/node_modules/

# Build output
frontend/dist/
frontend/build/
dist/
build/
coverage/

# Logs
*.log
logs/
npm-debug.log*

# OS & IDE
.DS_Store
Thumbs.db
.idea/
*.swp

